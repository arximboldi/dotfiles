#!/usr/bin/env bash
# hyprfocus <class>: focus a window of that class, preferring the current
# workspace. Fails if there is none, so callers can do `hyprfocus x || x`.

class=$1

addr=$(hyprctl clients -j | jq -r --arg class "$class" \
    --argjson ws "$(hyprctl activeworkspace -j | jq .id)" '
    [.[] | select(.class == $class)] | sort_by(.workspace.id != $ws) | .[0].address // empty')
[ -n "$addr" ] || exit 1

# Hyprland's Lua config: dispatch takes a Lua expression.
[ "$(hyprctl dispatch "hl.dsp.focus({window = \"address:$addr\"})")" = ok ]
