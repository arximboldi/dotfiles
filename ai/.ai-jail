
env_pass = [
  "NIX_LD",
  "NIX_LD_LIBRARY_PATH",
  "GITHUB_TOKEN",
  "GIT_SSH_COMMAND=ssh -F ~/.ssh/config"
]
ro_maps = [
  "/run/current-system",
  "~/.config/git",
  "~/dotfiles/git",
  "~/.ssh",
  "~/dotfiles/ssh",
  ".."
]
rw_maps = [
  "/nix/var/nix/daemon-socket/socket",
  "~/dotfiles/ai",
  "~/.darkmatter"
]
x11 = true
audio = true
network = true
agent_state = true
systemd_user = true
