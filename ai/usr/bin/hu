#!/usr/bin/env bash
# hu: herd utilities, small helpers on top of Herdr (herdr-app, hc) and git.
#
# Worktrees use the same layout as Herdr's worktree dialog,
# ~/.herdr/worktrees/<repo>/<branch>, so the sidebar nesting and the
# New/Open/Remove worktree dialogs work on checkouts made either way.

set -euo pipefail

ROOT="$HOME/.herdr/worktrees"

die() { echo "hu: $*" >&2; exit 1; }
tilde() { local p=$1; [[ $p == "$HOME"* ]] && p="~${p#"$HOME"}"; echo "$p"; }
# Same as the worktree mod's slug(): branch name -> folder name.
slug() { sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+|-+$//g' <<<"$1"; }

usage() {
  cat <<'EOF'
usage: hu <command> ...

  hu wt                        worktrees of this repo, and their spaces (also -l)
  hu wt <branch> [options]     open its checkout, or create it if there is none
  hu wt -o <branch|path>       open only: go to its space, or open one
  hu wt -c <branch>            create only: new checkout + a space on it
  hu wt -d [<branch|path>]     delete the checkout and close its spaces; default:
                               the one you're in. The branch goes too when another
                               branch has all its commits (merged, or same commit)

  options:
    -a, --agent <cmd>          run this in the new space (e.g. claude)
    -t, --task <text>          the agent's first message (implies -a claude)
    -b, --base <ref>           a new branch starts here (default: HEAD)
    -n, --no-space             create the checkout only, no space
    -f, --force                delete even with uncommitted changes
    -k, --keep-branch          with -d, keep the branch anyway

  hu notify                    desktop notifications when an agent needs you or
                               is done and Herdr isn't the focused window
                               (runs until killed; started with Hyprland)
EOF
}

# --- git -------------------------------------------------------------------

# Sets MAIN (the main checkout), NAME (repo name) for the repo at $PWD.
repo() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not in a git repository"
  MAIN=${common%/.git}
  [[ $MAIN != "$common" ]] || die "bare repositories aren't supported"
  NAME=$(basename "$MAIN")
}

# "path<TAB>branch" per checkout, the main one first; branch is empty if detached.
checkouts() {
  git -C "$MAIN" worktree list --porcelain | awk '
    /^worktree /  { if (p != "") print p "\t" b; p = substr($0, 10); b = "" }
    /^branch /    { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END           { if (p != "") print p "\t" b }'
}

# The checkout for a branch name or a path (absolute or relative).
find_checkout() {
  local want=$1 abs="" path branch
  [[ -e $want ]] && abs=$(cd "$want" && git rev-parse --show-toplevel 2>/dev/null || true)
  while IFS=$'\t' read -r path branch; do
    if [[ $branch == "$want" || $path == "$abs" ]]; then echo "$path"; return; fi
  done < <(checkouts)
  return 1
}

# --- herdr -----------------------------------------------------------------

# Space ids (this machine) whose folder is the checkout or inside it.
spaces_at() {
  herdr-app ls 2>/dev/null | jq -r --arg p "$1" '
    .spaces[] | select(.machine == null)
    | select(.folder == $p or (.folder | startswith($p + "/"))) | .id' || true
}

space_name() {
  herdr-app ls 2>/dev/null | jq -r --arg id "$1" '.spaces[] | select(.id == $id) | .name' || true
}

# open_space <folder> <agent> <task>
open_space() {
  local args=(--folder "$1")
  if [[ -n $2 ]]; then
    # shellcheck disable=SC2086 # the agent command is split into words on purpose
    args+=(--argv "$(jq -cn '$ARGS.positional' --args -- $2)")
    [[ -z $3 ]] || args+=(--task "$3")
  fi
  herdr-app "do" space.new "${args[@]}" >/dev/null || die "herdr-app couldn't open a space (is it running?)"
}

# --- wt --------------------------------------------------------------------

wt_list() {
  local path branch id names
  while IFS=$'\t' read -r path branch; do
    names=""
    while read -r id; do
      [[ -n $id ]] && names+="${names:+, }$(space_name "$id")"
    done < <(spaces_at "$path")
    printf '%-28s %-50s %s\n' "${branch:-(detached)}" "$(tilde "$path")" "${names:--}"
  done < <(checkouts)
}

wt_create() {
  local branch=$ARG
  git check-ref-format --branch "$branch" >/dev/null || die "invalid branch name: $branch"
  local existing
  if existing=$(find_checkout "$branch"); then
    die "$branch is already checked out at $(tilde "$existing") (hu wt $branch)"
  fi
  local path
  path="$ROOT/$NAME/$(slug "$branch")"
  [[ ! -e $path ]] || die "$(tilde "$path") already exists"
  mkdir -p "$(dirname "$path")"

  if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$branch"; then
    [[ -z $BASE ]] || echo "hu: $branch exists, ignoring --base" >&2
    git -C "$MAIN" worktree add "$path" "$branch"
  elif [[ -z $BASE ]] && git -C "$MAIN" for-each-ref --format=x "refs/remotes/*/$branch" | grep -q .; then
    git -C "$MAIN" worktree add "$path" "$branch"   # git sets up tracking
  else
    # A new branch starts from here: this checkout's HEAD, like the dialog.
    git -C "$MAIN" worktree add -b "$branch" "$path" "$(git rev-parse "${BASE:-HEAD}")"
  fi

  [[ -n $NOSPACE ]] || open_space "$path" "$AGENT" "$TASK"
  tilde "$path"
}

# wt_open <checkout path>
wt_open() {
  local path=$1 id
  [[ -z $BASE ]] || echo "hu: $ARG is already checked out, ignoring --base" >&2
  if [[ -n $NOSPACE ]]; then tilde "$path"; return; fi
  id=$(spaces_at "$path" | head -n1)
  if [[ -n $id && -z $AGENT ]]; then
    herdr-app "do" space.select --id "$id" >/dev/null
  else
    open_space "$path" "$AGENT" "$TASK"
  fi
}

# Why branch $1 can go: another branch (local or remote, not its own remote
# copy) has all its commits. Prints "merged into X" or "same commit as X";
# fails if there's none. Prefers the main checkout's branch and the default one.
branch_redundant() {
  local branch=$1 tip ref obj best="" upstream prefer why line
  tip=$(git rev-parse --verify --quiet "refs/heads/$branch") || return 1
  upstream=$(git rev-parse --symbolic-full-name --quiet "$branch@{upstream}" 2>/dev/null || true)
  prefer=" $(git symbolic-ref --quiet HEAD || true) $(git symbolic-ref --quiet refs/remotes/origin/HEAD || true) "
  while read -r ref obj; do
    [[ $ref == "refs/heads/$branch" || $ref == "$upstream" || $ref == refs/remotes/*/HEAD ]] && continue
    [[ $ref == refs/remotes/*/"$branch" ]] && continue   # its own pushed copy
    why="merged into"; [[ $obj == "$tip" ]] && why="same commit as"
    line="$why $(git rev-parse --abbrev-ref "$ref")"
    if [[ $prefer == *" $ref "* ]]; then echo "$line"; return; fi
    [[ -n $best ]] || best=$line
  done < <(git for-each-ref --contains "$tip" --format='%(refname) %(objectname)' refs/heads refs/remotes)
  [[ -n $best ]] && echo "$best"
}

wt_delete() {
  local path
  if [[ -n $ARG ]]; then
    path=$(find_checkout "$ARG") || die "no checkout of $ARG"
  else
    path=$(git rev-parse --show-toplevel)
  fi
  [[ $path != "$MAIN" ]] || die "that's the main checkout; not deleting it"

  # Collect the spaces first, delete, then close them last: this shell may be
  # running in one of them.
  local ids branch p b
  ids=$(spaces_at "$path")
  while IFS=$'\t' read -r p b; do [[ $p == "$path" ]] && branch=$b; done < <(checkouts)
  cd "$MAIN"
  git worktree remove $FORCE "$path" || die "not deleted (uncommitted changes? use -f)"
  echo "deleted $(tilde "$path")"

  local why
  if [[ -z ${branch:-} ]]; then
    :
  elif [[ -n $KEEP ]]; then
    echo "kept branch $branch (-k)"
  elif why=$(branch_redundant "$branch"); then
    git branch -q -D "$branch"
    echo "deleted branch $branch ($why)"
  else
    local pushed
    pushed=$(git for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch" | head -n1)
    echo "kept branch $branch: not merged anywhere${pushed:+ (pushed as $pushed)}"
  fi
  local id
  for id in $ids; do
    herdr-app "do" space.close --id "$id" --confirmed true >/dev/null || true
  done
}

wt() {
  local mode="" AGENT="" TASK="" BASE="" NOSPACE="" FORCE="" KEEP="" ARG=""
  setmode() { [[ -z $mode || $mode == "$1" ]] || die "pick one of -l, -o, -c, -d"; mode=$1; }
  while (($#)); do
    case $1 in
      -l|--list) setmode list ;;
      -o|--open) setmode open ;;
      -c|--create) setmode create ;;
      -d|--delete) setmode delete ;;
      -a|--agent) AGENT=${2:?--agent needs a command}; shift ;;
      -t|--task) TASK=${2:?--task needs text}; shift ;;
      -b|--base) BASE=${2:?--base needs a ref}; shift ;;
      -n|--no-space) NOSPACE=1 ;;
      -f|--force) FORCE=--force ;;
      -k|--keep-branch) KEEP=1 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option $1 (hu help)" ;;
      *) [[ -z $ARG ]] || die "unexpected argument $1"; ARG=$1 ;;
    esac
    shift
  done
  [[ -z $TASK || -n $AGENT ]] || AGENT=claude
  [[ -n $mode ]] || { [[ -n $ARG ]] && mode=auto || mode=list; }

  local creating="$BASE$NOSPACE" spawning="$AGENT"
  case $mode in
    list) [[ -z $ARG$creating$spawning$FORCE$KEEP ]] || die "-l takes no arguments" ;;
    delete) [[ -z $creating$spawning ]] || die "-d takes only -f and -k" ;;
    *) [[ -z $FORCE$KEEP ]] || die "-f and -k go with -d"
       [[ -n $ARG ]] || die "which branch? (hu help)" ;;
  esac
  [[ $mode != open || -z $creating ]] || die "-o takes only -a and -t"

  repo
  local path
  case $mode in
    list) wt_list ;;
    delete) wt_delete ;;
    create) wt_create ;;
    open) path=$(find_checkout "$ARG") || die "no checkout of $ARG (hu wt -c $ARG)"
          wt_open "$path" ;;
    auto) if path=$(find_checkout "$ARG"); then wt_open "$path"; else wt_create; fi ;;
  esac
}

# --- notify ----------------------------------------------------------------

# Herdr's own alerts (sound, toast) live inside its window. This adds a
# desktop notification when an agent needs you or is done and the Herdr
# window isn't the focused one; clicking it shows that agent.
notify() {
  [[ $# == 0 ]] || die "notify takes no arguments"
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hu-notify.lock"
  flock -n 9 || die "notify is already running"
  while :; do
    notify_follow || true
    sleep 2   # herdr-core restarting: follow it again
  done
}

notify_follow() {
  local kind t state prev
  local -A last=()
  hc events --json | jq --unbuffered -r '
    if .terminals then .terminals[] | ["seed", .address, .status.state // "-"]
    elif .params.type? == "status" then ["status", .params.terminal, .params.data.status.state // "-"]
    else empty end | @tsv' |
  while IFS=$'\t' read -r kind t state; do
    prev=${last[$t]:-}; last[$t]=$state
    [[ $kind == status && $state != "$prev" ]] || continue
    case $state in blocked|done) notify_agent "$t" "$state" & ;; esac
  done
}

notify_agent() {
  local t=$1 state=$2 info where text summary
  if command -v hyprctl >/dev/null; then
    [[ $(hyprctl activewindow -j | jq -r .class) != herdr-app ]] || return 0
  fi
  info=$(hc get "$t" --json) || return 0
  where=$(jq -r '.labels.where // .address' <<<"$info")
  text=$(jq -r '.title // .status.msg // ""' <<<"$info")
  case $state in
    blocked) summary="$where needs you" ;;
    *) summary="$where is done" ;;
  esac
  if [[ $(notify-send -a Herdr -i herdr-app -A default=Show "$summary" "$text") == default ]]; then
    herdr-app "do" agent.focus --terminal "$t" >/dev/null || true
    hyprfocus herdr-app >/dev/null 2>&1 || herdr-app
  fi
}

case ${1:-} in
  wt) shift; wt "$@" ;;
  notify) shift; notify "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (hu help)" ;;
esac
